# Prompt Shield API configuration.
# `npm run setup` copies this file to server/.env and fills in a random JWT_SECRET.
# On Vercel, add these under Project -> Settings -> Environment Variables instead.
# Never commit real secrets.

NODE_ENV="development"
PORT=5000
# Allowed CORS origin(s), comma-separated. Not needed when the UI and API share a domain (Vercel).
CLIENT_ORIGIN="http://localhost:5173"

# Database
# - Local: a SQLite file, relative to server/.
# - Vercel: connect a database through Vercel Storage so accounts persist. Supported:
#     PostgreSQL (Neon, Prisma Postgres, Supabase): DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
#       (POSTGRES_URL set by the integration also works)
#     Turso / libSQL: DATABASE_URL="libsql://<database>-<org>.turso.io" plus DATABASE_AUTH_TOKEN="<token>"
#       (TURSO_DATABASE_URL / TURSO_AUTH_TOKEN from the Vercel Turso integration also work)
#   Without one, Vercel falls back to a temporary database that resets when the instance restarts.
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=

# Signs login sessions. Optional when a database is connected: a random secret is then generated
# once and stored in it. To set your own, use a long random string (64+ hex characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN="8h"
BCRYPT_ROUNDS=12

# Create the demo account (demo@promptshield.local / Demo@12345) automatically when it is missing.
DEMO_ACCOUNT="true"

# Analysis mode: auto | local | openai | gemini (auto uses an AI provider only when a key is set)
AI_PROVIDER="auto"
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"
AI_TIMEOUT_MS=20000

TOKEN_PRICE_PER_MILLION_USD=0.5
MAX_UPLOAD_BYTES=262144
RATE_LIMIT_ENABLED="true"
