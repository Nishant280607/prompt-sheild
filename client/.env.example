# Optional client configuration (copy to client/.env to use).
# Leave VITE_API_URL empty in development: Vite proxies /api to the backend.
# Set it when the API runs on a different origin, e.g. https://api.example.com
VITE_API_URL=
# Where the Vite dev server proxies /api requests
VITE_DEV_API_PROXY=http://localhost:5000
